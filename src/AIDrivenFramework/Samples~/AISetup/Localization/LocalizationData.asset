    japanese: "\u30e2\u30c7\u30eb\u306e\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u304c\u7c21\u5358\u3067\u3059"
    english: "Easily download and manage models"
  - key: RuntimeSelection.Ollama.Feature3
    japanese: "\u5c11\u306a\u3044\u8a2d\u5b9a\u3067\u3059\u3050\u306b\u59cb\u3081\u3089\u308c\u307e\u3059"
