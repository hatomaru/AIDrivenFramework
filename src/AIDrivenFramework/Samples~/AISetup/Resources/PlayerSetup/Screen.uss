/* Explicit steady-state colors are checked by Tools/check_setup_contrast.py. */
.screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 72px 24px 56px; background-color: #F5F5F7; color: #202124; align-items: center; justify-content: center; }
Label { white-space: normal; }
Button { color: #202124; background-color: #FFFFFF; border-width: 1px; border-color: #63717D; border-radius: 10px; min-height: 42px; padding: 8px 18px; margin: 0; font-size: 16px; }
Button:hover { background-color: #E9EEF6; }
Button:focus { border-color: #0056B3; border-width: 3px; }
Button:disabled { opacity: 1; color: #3A4652; background-color: #DCE2E8; }
.languages { position: absolute; top: 20px; right: 28px; flex-direction: row; }
.languages Button { min-height: 36px; font-size: 14px; margin-left: 6px; padding: 5px 12px; }
.active-language, .active-language:hover, .active-language:focus { background-color: #0056B3; color: #FFFFFF; border-color: #0056B3; }
.card { width: 640px; max-width: 100%; height: 680px; min-height: 0; flex-shrink: 1; background-color: #FFFFFF; border-radius: 30px; border-width: 1px; border-color: #FFFFFF; overflow: hidden; }
.slide-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; }
.unity-scroller--vertical { width: 8px; }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider { min-width: 8px; margin: 0; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: #FFFFFF; border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: #63717D; border-width: 0; border-radius: 4px; }
.slide { padding: 34px 36px 24px; align-items: center; }
.title { font-size: 32px; -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 12px; margin-bottom: 14px; }
.description { font-size: 17px; color: #484F56; -unity-text-align: middle-center; margin-bottom: 20px; }
.note { font-size: 14px; color: #484F56; -unity-text-align: middle-center; margin-top: 10px; margin-bottom: 10px; }
.chosen { font-size: 16px; color: #484F56; margin-top: 22px; margin-bottom: 8px; }
.icon-orbit { width: 160px; height: 128px; align-items: center; justify-content: center; margin-bottom: 16px; }
.setup-icon { width: 104px; height: 104px; }
.spark { position: absolute; left: 77px; top: 61px; width: 6px; height: 6px; border-radius: 3px; background-color: #546BA6; }
Button.link { color: #0056B3; background-color: #FFFFFF; border-color: #FFFFFF; font-size: 15px; }
Button.link:hover { background-color: #E9EEF6; border-color: #E9EEF6; }
Button.link:focus { border-color: #0056B3; }
.model-cards { width: 100%; margin-top: 8px; margin-bottom: 10px; }
.model-card { flex-direction: row; align-items: center; justify-content: space-between; width: 100%; min-height: 76px; padding: 10px 18px; margin-bottom: 10px; }
.model-card.selected, .model-card.selected:hover { background-color: #EEF4FC; border-color: #0056B3; border-width: 2px; }
.model-labels { align-items: flex-start; }
.model-tier { font-size: 17px; -unity-font-style: bold; color: #202124; }
.model-labels .note { margin: 4px 0 0; -unity-text-align: middle-left; }
.model-size { font-size: 16px; color: #484F56; }
.details { width: 100%; background-color: #F5F5F7; border-radius: 14px; padding: 16px 20px; margin-bottom: 18px; }
.selection-name { font-size: 18px; -unity-font-style: bold; margin-bottom: 8px; }
.detail { font-size: 15px; color: #484F56; margin-top: 4px; }
.details .note { font-size: 13px; -unity-text-align: middle-left; margin-bottom: 0; }
.terms-links { flex-direction: row; margin-bottom: 10px; }
.terms-links Button { font-size: 14px; padding-left: 10px; padding-right: 10px; }
.consent { font-size: 16px; width: 100%; margin-top: 6px; }
.consent .unity-toggle__text { color: #202124; white-space: normal; }
.unity-toggle__input { align-items: flex-start; }
.unity-toggle__checkmark { width: 20px; height: 20px; margin-right: 8px; border-color: #63717D; }
.actions { flex-direction: row; justify-content: center; padding: 18px 32px 26px; flex-shrink: 0; }
.actions Button { min-width: 130px; min-height: 46px; }
Button.primary { margin-left: 12px; background-color: #0056B3; border-color: #0056B3; color: #FFFFFF; -unity-font-style: bold; }
Button.primary:hover, Button.primary:focus { background-color: #00448F; border-color: #00448F; color: #FFFFFF; }
Button.primary:disabled { background-color: #DCE2E8; border-color: #63717D; color: #3A4652; opacity: 1; }
.footer { background-color: #FFFFFF; border-radius: 14px; padding: 8px 12px; position: absolute; bottom: 20px; right: 28px; font-size: 14px; color: #484F56; }
.footer .unity-toggle__text { color: #484F56; }
TextField, DropdownField { width: 100%; margin: 6px 0; flex-direction: column; align-items: stretch; color: #202124; }
.unity-base-field__label { min-width: 0; font-size: 14px; margin-bottom: 4px; color: #484F56; }
TextField .unity-base-field__input, DropdownField .unity-base-field__input { min-height: 32px; font-size: 16px; color: #202124; background-color: #FFFFFF; border-color: #63717D; border-width: 1px; border-radius: 5px; }
.unity-text-field__input { color: #202124; background-color: #FFFFFF; }
.error { font-size: 15px; color: #A52A2A; margin-top: 10px; }
ProgressBar { width: 100%; height: 10px; margin-top: 36px; }
.unity-progress-bar__background { height: 10px; background-color: #DCE2E8; border-width: 0; border-radius: 5px; }
.unity-progress-bar__progress { background-color: #0056B3; border-width: 0; border-radius: 5px; }
.unity-progress-bar__title { display: none; }
.percent { font-size: 22px; -unity-font-style: bold; color: #202124; margin-top: 18px; margin-bottom: 8px; }
.result-symbol { width: 92px; height: 92px; border-radius: 46px; -unity-text-align: middle-center; font-size: 46px; color: #FFFFFF; background-color: #0056B3; margin-top: 24px; margin-bottom: 22px; }
.compact { padding: 64px 16px 52px; }
.compact .card { border-radius: 18px; }
.compact .slide { padding: 24px 24px 16px; }
.compact .title { font-size: 28px; }
.compact .actions { padding: 16px 24px 20px; }
.compact .title { margin-top: 0; margin-bottom: 10px; }
.compact .description { font-size: 16px; margin-bottom: 14px; }
.compact .details { padding: 12px 16px; margin-bottom: 14px; }

.result-seal { width: 180px; height: 140px; align-items: center; justify-content: center; margin-top: 18px; margin-bottom: 12px; }
.result-seal .result-symbol { margin: 0; }
.celebration-spark { position: absolute; left: 87px; top: 67px; width: 6px; height: 6px; border-radius: 3px; background-color: #546BA6; }
.download-stats { font-size: 16px; color: #484F56; margin-top: 6px; -unity-text-align: middle-center; }
.stage-caption { font-size: 14px; color: #484F56; margin-top: 6px; -unity-text-align: middle-center; }
#slide-Progress ProgressBar { margin-top: 16px; }
#slide-Progress .icon-orbit { height: 96px; margin-bottom: 8px; }
#slide-Progress .setup-icon { width: 88px; height: 88px; }
.file-choice { width: 100%; flex-direction: row; align-items: flex-end; margin-top: 6px; margin-bottom: 6px; }
.file-choice TextField { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 8px 0 0; }
.file-choice Button { min-height: 34px; font-size: 14px; padding: 4px 10px; }
.llama-help { width: 100%; flex-direction: row; justify-content: center; }
#slide-Custom .note { margin: 6px 0; }
#slide-Custom .title { font-size: 28px; }
#slide-Custom .description { font-size: 15px; margin-bottom: 10px; }
#slide-Custom #backend { display: none; }
.runtime-card { width: 100%; padding: 20px; margin: 8px 0; align-items: flex-start; }
.runtime-card .note { -unity-text-align: middle-left; margin-bottom: 0; }
#slide-Models .slide { padding-top: 20px; }
#slide-Models .model-card { min-height: 66px; margin-bottom: 6px; }
#slide-Models Button.link { min-height: 34px; padding-top: 4px; padding-bottom: 4px; }

.file-kind-icon { width: 40px; height: 40px; flex-shrink: 0; border-radius: 12px; margin-right: 12px; background-color: #0056B3; }
.file-choice .file-kind-icon { margin-bottom: 0; }
.file-browser { width: 100%; align-items: stretch; }
.file-browser .title { font-size: 28px; }
.file-browser .description { font-size: 15px; margin-bottom: 12px; }
.browser-shortcuts { flex-direction: row; align-items: center; margin-bottom: 8px; }
.browser-shortcuts Button { padding: 6px 10px; font-size: 14px; min-height: 34px; margin-right: 6px; }
#browser-drive { width: 80px; flex-grow: 1; margin: 0; }
.browser-address { flex-direction: row; align-items: flex-end; }
#browser-location { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.browser-address Button { min-height: 34px; margin-bottom: 6px; padding: 4px 12px; }
#browser-files { height: 260px; min-height: 120px; }
.browser-row { flex-direction: row; align-items: center; padding: 10px 12px; min-height: 66px; margin-bottom: 6px; }
.browser-labels { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.browser-name { font-size: 15px; -unity-text-align: middle-left; }
.browser-type { font-size: 13px; color: #484F56; margin-top: 3px; -unity-text-align: middle-left; }
.browser-row:disabled .browser-type { color: #3A4652; }
#gguf-catalog { margin-top: 12px; }
#slide-Custom .file-kind-icon { width: 40px; height: 40px; }

.file-browser { padding: 22px 28px 16px; }
.file-browser .title { font-size: 26px; margin-top: 0; margin-bottom: 8px; }
.file-browser .description { font-size: 14px; margin-bottom: 10px; }
.file-browser .note { font-size: 13px; margin: 6px 0; }
.file-browser TextField { margin-top: 4px; margin-bottom: 4px; }
#browser-drive { width: 110px; flex-grow: 0; }
#browser-drive .unity-base-popup-field__text { min-width: 0; white-space: nowrap; -unity-text-align: middle-left; }
#browser-files { height: 230px; }
.browser-name { margin: 0; }
.browser-type { margin: 3px 0 0; }

.browser-loading { height: 6px; width: 100%; margin-top: 0; margin-bottom: 8px; flex-shrink: 0; overflow: hidden; }
.browser-loading .unity-progress-bar__background { height: 6px; }
.browser-loading .unity-progress-bar__progress { height: 6px; }
